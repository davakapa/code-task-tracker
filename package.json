{
  "name": "code-task-tracker",
  "displayName": "CodeTask Tracker",
  "description": "Задачи TODO/FIXME/BUG/HACK/NOTE в комментариях C/C++: панель, приоритеты, переход и фильтры",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-task-tracker.helloWorld",
        "title": "CodeTask Tracker: Проверить запуск"
      },
      {
        "command": "code-task-tracker.scanCurrentFile",
        "title": "CodeTask Tracker: Найти задачи в текущем файле"
      },
      {
        "command": "code-task-tracker.refresh",
        "title": "CodeTask Tracker: Обновить задачи проекта",
        "icon": "$(refresh)"
      },
      {
        "command": "code-task-tracker.filter",
        "title": "CodeTask Tracker: Настроить фильтры",
        "icon": "$(filter)"
      },
      {
        "command": "code-task-tracker.search",
        "title": "CodeTask Tracker: Поиск по тексту задачи",
        "icon": "$(search)"
      },
      {
        "command": "code-task-tracker.resetFilters",
        "title": "CodeTask Tracker: Сбросить фильтры",
        "icon": "$(clear-all)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "codeTaskTracker.tasks",
          "name": "CodeTask Tracker",
          "icon": "$(checklist)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "code-task-tracker.refresh",
          "when": "view == codeTaskTracker.tasks",
          "group": "navigation"
        },
        {
          "command": "code-task-tracker.filter",
          "when": "view == codeTaskTracker.tasks",
          "group": "navigation@1"
        },
        {
          "command": "code-task-tracker.search",
          "when": "view == codeTaskTracker.tasks",
          "group": "navigation@2"
        },
        {
          "command": "code-task-tracker.resetFilters",
          "when": "view == codeTaskTracker.tasks",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && node --test out/test/*.unit.js",
    "package:vsix": "vsce package --no-dependencies --skip-license --githubBranch main"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.144.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "publisher": "davakapa",
  "author": {
    "name": "davakapa"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/davakapa/code-task-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/davakapa/code-task-tracker/issues"
  }
}
